{
  "name": "encounter-factory",
  "private": true,
  "version": "0.1.0",
  "description": "Local source-available preview for structured tabletop encounter design.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": "https://github.com/Mortonas/Encounter-Factory",
  "engines": {
    "node": ">=22 <23"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "Base/template.html"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm --packages=external",
    "start": "NODE_ENV=production node dist/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server server.ts vite.config.ts vitest.config.ts eslint.config.js",
    "release:generate": "node scripts/public-release/generate-controlled-files.mjs",
    "release:check": "node scripts/public-release/check-public-release.mjs --working-tree"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.5"
  }
}
