# Copy this file to .env and replace every placeholder before startup.
# Never commit .env. The server exits before listening when operator values are unsafe.
OPERATOR_ID="00000000-0000-4000-8000-000000000000"
OPERATOR_TOKEN="replace-with-a-random-token-of-at-least-32-characters"

# Local Node defaults are shown explicitly. Docker Compose overrides HOST to 0.0.0.0
# inside the container while publishing the port only on the host loopback interface.
HOST="127.0.0.1"
PORT="3000"

# Required only when intentionally running a generation job.
GEMINI_API_KEY="replace-with-your-provider-key"
